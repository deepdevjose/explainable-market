# Reference only. The application does not load .env files automatically.
# Export variables in your shell or use a private service configuration.
APP_ENV=development
HOST=127.0.0.1
PORT=5050
DATABASE_PATH=data/market-live.db
# Generate privately; keep stable across restarts. Required in production.
# python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=
COOKIE_SECURE=0
# Only an exact trusted reverse proxy IP; never use *.
TRUSTED_PROXY=

# Optional educational assistant: deepseek or bigmodel. Leave keys empty here.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
BIGMODEL_API_KEY=
BIGMODEL_MODEL=glm-5.3-flash

# Optional market provider. Data licensing is separate from software licensing.
TWELVE_DATA_API_KEY=
# Enable only after confirming external display rights with the provider.
TWELVE_DATA_PUBLIC_DISPLAY=0
